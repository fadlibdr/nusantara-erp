APP_NAME="Nusantara ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

ERP_COMPANY_NAME="PT Nusantara Karya Integrasi"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL/MariaDB (production-style). For a zero-config demo use the sqlite block below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_construction
DB_USERNAME=root
DB_PASSWORD=
# Sesudah cut-over SQLite → MySQL (Fase 0): berkas SQLite lama yang dibaca
# erp:sqlite-to-mysql / erp:migration-verify lewat koneksi sqlite_legacy.
# SQLITE_LEGACY_PATH=/var/www/erp1.pi2.co.id/database/database.sqlite

# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.co.id"
MAIL_FROM_NAME="${APP_NAME}"
