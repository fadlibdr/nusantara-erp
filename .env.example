APP_NAME="Nusantara ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

ERP_COMPANY_NAME="PT Nusantara Karya Integrasi"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL/MariaDB (production-style). For a zero-config demo use the sqlite block below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_construction
DB_USERNAME=root
DB_PASSWORD=
# Sesudah cut-over SQLite → MySQL (Fase 0): berkas SQLite lama yang dibaca
# erp:sqlite-to-mysql / erp:migration-verify lewat koneksi sqlite_legacy.
# SQLITE_LEGACY_PATH=/var/www/erp1.pi2.co.id/database/database.sqlite

# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.co.id"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP sungguhan (P-3a; runbook DEPLOYMENT.md §11) — selama MAIL_MAILER=log setiap
# e-mail dicatat Dilewati "belum ada server surel", bukan Terkirim.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# (MAIL_ENCRYPTION tidak dibaca Laravel 12: 587 = STARTTLS otomatis; MAIL_SCHEME=smtps hanya untuk 465)
# MAIL_USERNAME=
# MAIL_PASSWORD=

# WhatsApp — Meta Cloud API langsung (P-3a, docs/KEPUTUSAN-INTEGRASI.md). SEMUA KOSONG
# sampai tiga prasyarat pemilik terpenuhi; selama kosong kanal ada tetapi Dilewati.
# Rahasia HANYA di .env — tidak pernah di core_settings, jawaban API, atau log.
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=id
# Nama template yang DISETUJUI Meta, tiga placeholder {{1}} judul {{2}} isi {{3}} tautan.
WHATSAPP_TEMPLATE_DEADLINE_DUE=
WHATSAPP_TEMPLATE_APPROVAL_ESCALATED=
WHATSAPP_TEMPLATE_AR_DUNNING=
WHATSAPP_TEMPLATE_BACKUP_STALE=
WHATSAPP_TEMPLATE_SCHEDULER_DOWN=
