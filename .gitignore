# ---------------------------------------------------------------- data hidup
# database/database.sqlite adalah DATA DEMO YANG HIDUP, bukan fixture: berisi
# NIK KTP, NPWP, nomor rekening dan gaji delapan karyawan, plus NPWP pelanggan
# dan vendor. Sekali ter-commit ia tinggal di riwayat git selamanya, walau
# dihapus di commit berikutnya. Skema + seeder di repo ini sudah cukup untuk
# membangun demo yang jalan (`php artisan migrate --seed`), jadi berkasnya
# tidak perlu ikut.
/database/*.sqlite
/database/*.sqlite-wal
/database/*.sqlite-shm
/database/*.sqlite.bak

# Lampiran yang diunggah pengguna adalah data hidup dengan alasan yang sama —
# core_attachments menunjuk ke sini. Berkas .gitignore di dalamnya tetap ikut
# supaya direktorinya ada setelah clone.
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# Konfigurasi cadangan memuat tujuan offsite dan nama berkas kunci.
/deploy/erp1-backup.conf
