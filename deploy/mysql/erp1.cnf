# MySQL 8 drop-in for erp1 (bare-metal, 1 vCPU / 3.9 GB RAM shared with
# php-fpm + nginx). Installed as /etc/mysql/mysql.conf.d/erp1.cnf — the
# file name sorts AFTER mysqld.cnf, so every key here overrides the
# distribution default of the same name. Source of truth is this copy in the
# repository; docs/DEPLOYMENT.md §10 says how it gets there.
#
# Why each value (measured 5 Sep 2026 unless stated):
#   innodb_buffer_pool_size  384M — the whole ERP is ~3 MB on SQLite; 384M holds
#                            it many times over and leaves ~2 GB for php-fpm
#                            (distribution default 128M would also fit, but
#                            the pool is where index pages live under the 40/80
#                            parallel bursts T0.7 measures). Not larger: no
#                            swap on this host.
#   max_connections          60 — php-fpm on erp1 has few workers; 151 (default)
#                            only lets a runaway burst hold more memory.
#   sql_mode                 STRICT_TRANS_TABLES,NO_ZERO_DATE,
#                            ERROR_FOR_DIVISION_BY_ZERO — the server-side floor
#                            for clients that are NOT Laravel (mysql CLI,
#                            mysqldump restore). Laravel's connection sets its
#                            own, stricter session mode on connect
#                            ('strict' => true in config/database.php).
#   innodb_lock_wait_timeout 10 s — lockForUpdate() is real on MySQL for the
#                            first time (141 sites); a waiter should fail in
#                            10 s, not hold a php-fpm worker for the default 50.
#   character set / collation utf8mb4 / utf8mb4_unicode_ci — the same pair
#                            config/database.php uses per table (DB_COLLATION
#                            default), so a database created from the CLI and
#                            one created by Laravel compare the same way.
#   slow_query_log           on, threshold 2 s, /var/log/mysql/slow.log — the
#                            SQLite era had no per-query timing at all.
#   bind-address             127.0.0.1 — the ERP and MySQL share the host;
#                            nothing outside it may reach port 3306.
#   disable_log_bin          no replica and no point-in-time recovery here:
#                            backups are mysqldump --single-transaction
#                            (roadmap P-0). The binary log would only double
#                            every write on a 36 GB disk.
#   mysqlx                   off — the X protocol listener (33060) is unused.

[mysqld]
bind-address                  = 127.0.0.1
mysqlx                        = 0

character-set-server          = utf8mb4
collation-server              = utf8mb4_unicode_ci

sql_mode                      = STRICT_TRANS_TABLES,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO

max_connections               = 60
innodb_buffer_pool_size       = 384M
innodb_lock_wait_timeout      = 10

disable_log_bin

slow_query_log                = 1
slow_query_log_file           = /var/log/mysql/slow.log
long_query_time               = 2
log_timestamps                = SYSTEM
