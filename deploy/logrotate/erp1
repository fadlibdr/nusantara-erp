# Log host ERP erp1.pi2.co.id (Fase 0 / P-0b). Menggantikan /etc/logrotate.d/erp1
# lama yang hanya mengenal erp1-backup.log dan erp1-schedule.log.
#
# copytruncate: unit systemd membuka log dengan StandardOutput=append: dan
# TIDAK membuka ulang berkasnya saat dirotasi; tanpa copytruncate, proses
# terus menulis ke inode lama yang sudah dipindahkan dan berkas baru tetap
# kosong. Pasang: install -m 0644 deploy/logrotate/erp1 /etc/logrotate.d/erp1
/var/log/erp1/queue.log /var/log/erp1/scheduler.log /var/log/erp1/watchdog.log {
    # TANPA `su www-data`: berkas-berkas ini milik root — systemd membuka
    # StandardOutput=append: sebelum melepas hak ke User=www-data, dan
    # watchdog.log ditulis cron sebagai root — sehingga logrotate yang beralih
    # ke www-data gagal "error opening …: Permission denied" pada ketiganya,
    # keluar 1, tidak ada yang dirotasi (diukur 5 Sep 2026). `su root adm`
    # global di /etc/logrotate.conf merotasinya; direktori www-data 0755
    # diterima (pemeriksaan "parent directory has insecure permissions" hanya
    # berlaku tanpa direktif su — diukur 5 Sep 2026; README langkah 1 tetap
    # 0755). Berkas ini jangan dijalankan sendirian (`logrotate … /etc/
    # logrotate.d/erp1`): tanpa su global blok kedua ditolak, dan dengan -f
    # dua log bulanan itu dirotasi di luar jadwal — README langkah 4 memeriksa
    # lewat `logrotate -d /etc/logrotate.conf`. Salinan lama root:root 0644
    # tetap terbaca siapa pun.
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# Log cron yang tetap ada (backup, root) dan log schedule:run lama — berkas
# lama dibiarkan sampai kosong (missingok), tidak dihapus tangan.
/var/log/erp1-backup.log /var/log/erp1-schedule.log {
    monthly
    rotate 6
    compress
    missingok
    notifempty
}
