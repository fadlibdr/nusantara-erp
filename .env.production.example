# =============================================================================
# Nusantara ERP — production environment template
# =============================================================================
# Copy to .env next to docker-compose.prod.yml, then fill every CHANGE_ME.
# NEVER commit the filled-in .env file. (Jangan commit file .env yang sudah
# terisi — berisi kredensial produksi.)
#
# Passwords: use long random values, e.g.  openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Nusantara ERP"
APP_ENV=production
# Generate with:
#   docker compose -f docker-compose.prod.yml build
#   docker run --rm --entrypoint php construction-erp-app:latest artisan key:generate --show
# then paste the "base64:..." value here. The app will not boot without it.
# (Do NOT use `compose run app` for this — it would start mysql/redis and, with
# RUN_MIGRATIONS=1, initialize the database before credentials are filled in.)
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# Public HTTPS URL of the API (TLS is terminated by the host reverse proxy).
APP_URL=https://erp.example.co.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

ERP_COMPANY_NAME="PT Nusantara Karya Integrasi"

# -----------------------------------------------------------------------------
# Security / hardening
# -----------------------------------------------------------------------------
# Force https:// URL generation (containers sit behind a TLS-terminating proxy).
FORCE_HTTPS=true
# Global API throttle, requests per minute per user (fallback: per IP).
API_RATE_LIMIT=120
# Sanctum bearer-token lifetime in minutes (720 = 12 hours).
SANCTUM_TOKEN_EXPIRATION=720
# Session cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
# Comma-separated list of browser origins allowed to call the API (CORS).
# Empty = no cross-origin browser access. Example:
# CORS_ALLOWED_ORIGINS=https://erp.example.co.id,https://app.example.co.id
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Logging (container-friendly: logs go to stderr, collect with `docker logs`)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database (MySQL 8 — "mysql" is the compose service name)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_construction
DB_USERNAME=CHANGE_ME
# Strong password! e.g.  openssl rand -base64 32   (password kuat, acak, panjang)
DB_PASSWORD=CHANGE_ME

# MySQL root password, used only for administration/backups. The compose file
# interpolates DB_DATABASE / DB_USERNAME / DB_PASSWORD above into the mysql
# container on FIRST startup; root gets this password. Keep it different from
# DB_PASSWORD and just as strong. If unset, it falls back to DB_PASSWORD.
DB_ROOT_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Redis (cache + session + queue — "redis" is the compose service name)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# Filesystem / broadcasting
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Switch to smtp + real credentials when outgoing mail is needed.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.co.id"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.co.id
# MAIL_PORT=587
# MAIL_USERNAME=CHANGE_ME
# MAIL_PASSWORD=CHANGE_ME
# MAIL_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# Deployment behavior (read by deploy/docker/entrypoint.sh)
# -----------------------------------------------------------------------------
# 1 = run "php artisan migrate --force" automatically on container start.
# Set to 0 if you prefer running migrations manually during deploys.
RUN_MIGRATIONS=1

# Seconds the entrypoint waits for MySQL before giving up (raise on slow disks).
# DB_WAIT_TIMEOUT=60

# Host port nginx binds to on 127.0.0.1 (fronted by your TLS reverse proxy).
# HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Initial admin account — read ONLY by:
#   php artisan db:seed --class=ProductionSeeder --force
# Seeds master data, roles/permissions, and this single admin user. No demo
# documents are created. Remove/rotate the password after first login.
# -----------------------------------------------------------------------------
ERP_ADMIN_NAME="Administrator"
ERP_ADMIN_EMAIL=admin@example.co.id
# Strong password — min. 16 chars, random. (Wajib diganti sebelum seeding!)
ERP_ADMIN_PASSWORD=CHANGE_ME
