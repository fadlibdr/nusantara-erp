<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suite yang sama dengan phpunit.xml, dijalankan di MySQL 8 (Fase 0 T0.3).

  Basis data erp_test dibangun ulang oleh RefreshDatabase (migrate:fresh sekali
  per proses PHP, lalu satu transaksi per tes). Kredensial TIDAK ada di berkas
  ini: DB_USERNAME dan DB_PASSWORD dibaca dari lingkungan saat dijalankan —
  <env> PHPUnit tidak menimpa variabel yang sudah ada (force="false"), jadi
  nilai di sini hanya bawaan.

    set -a; . <berkas-cred>; set +a
    vendor/bin/phpunit -c phpunit.mysql.xml

  CI (.github/workflows/ci.yml, job phpunit-mysql) memasoknya lewat env job.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="erp_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
